{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ivme.dev/schemas/kaynakli-ipucu-v1.schema.json",
  "title": "İvme kaynaklı kısa ipucu v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "hint_id", "question", "note", "content", "review"],
  "properties": {
    "schema_version": {"const": 1},
    "hint_id": {"type": "string", "pattern": "^hint:[a-zA-Z0-9:_-]+$"},
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "image_sha256", "taxonomy_version", "question_type_code"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "image_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "taxonomy_version": {"type": "string", "minLength": 1},
        "question_type_code": {"type": "string", "minLength": 1}
      }
    },
    "note": {
      "type": "object", "additionalProperties": false,
      "required": ["note_id", "review_version", "catalog_id", "pdf_sha256", "page"],
      "properties": {
        "note_id": {"type": "string", "pattern": "^ogm-note:[a-f0-9]{32}$"},
        "review_version": {"type": "integer", "minimum": 1},
        "catalog_id": {"type": "integer", "minimum": 1},
        "pdf_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "page": {"type": "integer", "minimum": 1}
      }
    },
    "content": {
      "type": "object", "additionalProperties": false,
      "required": ["pre_answer_hint", "post_submission_explanation"],
      "properties": {
        "pre_answer_hint": {"type": ["string", "null"], "maxLength": 500},
        "post_submission_explanation": {"type": ["string", "null"], "maxLength": 1000}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "version", "reviewer_id", "reviewed_at_utc", "answer_leak_checked"],
      "properties": {
        "status": {"enum": ["draft", "needs_review", "approved", "rejected"]},
        "version": {"type": "integer", "minimum": 1},
        "reviewer_id": {"type": ["string", "null"], "maxLength": 80},
        "reviewed_at_utc": {"type": ["string", "null"], "format": "date-time"},
        "answer_leak_checked": {"type": "boolean"}
      }
    }
  },
  "allOf": [{
    "if": {"properties": {"review": {"properties": {"status": {"const": "approved"}}}}},
    "then": {"properties": {
      "content": {"properties": {
        "pre_answer_hint": {"type": "string", "minLength": 1},
        "post_submission_explanation": {"type": "string", "minLength": 1}
      }},
      "review": {"properties": {
        "reviewer_id": {"type": "string", "minLength": 1},
        "reviewed_at_utc": {"type": "string", "format": "date-time"},
        "answer_leak_checked": {"const": true}
      }}
    }}
  }]
}
