{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ivme.dev/schemas/learning-resource-v2.schema.json",
  "title": "İvme ortak kaynak ve konu ilişkisi v2",
  "type": "object",
  "required": ["contractVersion", "key", "kind", "originalTitle", "originalFilename", "displayTitle", "sourceVersion", "taxonomyVersion", "automaticLabels"],
  "properties": {
    "contractVersion": {"const": 2},
    "key": {"type": "string", "minLength": 1},
    "kind": {"enum": ["QUESTION", "PDF", "VIDEO", "NOTE", "TOPIC"]},
    "originalTitle": {"type": "string", "minLength": 1},
    "originalFilename": {"type": ["string", "null"]},
    "displayTitle": {"type": "string", "minLength": 1},
    "sourceVersion": {"type": "string", "minLength": 1},
    "taxonomyVersion": {"type": "string", "minLength": 1},
    "manualReview": {"type":"object", "required":["status","code","label","reason","pages"], "properties":{
      "status":{"const":"NEEDS_MANUAL_REVIEW"}, "code":{"enum":["EMPTY_OR_UNREADABLE","LOCATION_REVIEW","LABEL_REVIEW","TIME_REVIEW","SOURCE_REPAIR"]},
      "label":{"type":"string","minLength":1}, "reason":{"type":"string","minLength":1},
      "pages":{"type":"array","items":{"type":"object","required":["page","status","label","reason"],"properties":{
        "page":{"type":"integer","minimum":1},"status":{"const":"NEEDS_MANUAL_REVIEW"},"label":{"type":"string","minLength":1},"reason":{"type":"string","minLength":1}}}}}},
    "automaticLabels": {
      "type": "object", "required": ["assignments"],
      "properties": {"assignments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assignment"}}}
    }
  },
  "$defs": {
    "evidence": {
      "type": "object", "required": ["association", "reference", "sourceVersion", "method", "readability"],
      "properties": {
        "association": {"enum": ["RELATION", "ITEM_ONLY"]},
        "reference": {"type": "string", "minLength": 1},
        "sourceVersion": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "readability": {"enum": ["NOT_MEASURED", "GOOD", "POOR", "FAILED"]}
      }
    },
    "locator": {
      "oneOf": [
        {"type": "object", "required": ["type", "sourceKey", "pdfPageStart", "pdfPageEnd", "pageCount"], "properties": {
          "type": {"const": "PDF"}, "sourceKey": {"type": "string", "minLength": 1},
          "pdfPageStart": {"type": "integer", "minimum": 1}, "pdfPageEnd": {"type": "integer", "minimum": 1},
          "pageCount": {"type": "integer", "minimum": 1}, "printedPageLabel": {"type": "string"}
        }},
        {"type": "object", "required": ["type", "startSeconds", "endSeconds", "durationSeconds"], "properties": {
          "type": {"const": "VIDEO"}, "startSeconds": {"type": "number", "minimum": 0},
          "endSeconds": {"type": "number", "exclusiveMinimum": 0}, "durationSeconds": {"type": "number", "exclusiveMinimum": 0}
        }},
        {"type": "object", "required": ["type", "questionCode"], "properties": {
          "type": {"const": "QUESTION"}, "questionCode": {"type": "string", "minLength": 1},
          "questionNumbers": {"type":"array", "uniqueItems":true, "items":{"type":"integer", "minimum":1}}
        }},
        {"type": "object", "required": ["type", "sectionId", "sourceKey"], "properties": {
          "type": {"const": "NOTE"}, "sectionId": {"type": "string", "minLength": 1}, "sourceKey": {"type": "string", "minLength": 1},
          "patternId": {"type":"string", "minLength":1}
        }}
      ]
    },
    "review": {
      "type": "object", "required": ["status", "reviewer", "reviewedAt", "sourceVersion", "categoryFingerprint"],
      "properties": {
        "status": {"enum": ["PENDING", "APPROVE", "FIX", "WRONG_BRANCH", "REMOVE", "UNSURE", "STALE"]},
        "reviewer": {"type": ["string", "null"]}, "reviewedAt": {"type": ["string", "null"], "format": "date-time"},
        "sourceVersion": {"type": "string", "minLength": 1}, "categoryFingerprint": {"type": "string", "minLength": 1}
      },
      "allOf": [{"if": {"properties": {"status": {"const": "APPROVE"}}}, "then": {"properties": {
        "reviewer": {"type": "string", "minLength": 1}, "reviewedAt": {"type": "string", "format": "date-time"}
      }}}]
    },
    "assignment": {
      "type": "object",
      "required": ["categoryId", "relation", "relationKey", "sourceVersion", "categoryFingerprint", "scopeStatus", "confidence", "confidenceReason", "evidence", "locatorStatus", "locatorReason", "locators", "review"],
      "properties": {
        "categoryId": {"type": "string", "minLength": 1}, "relationKey": {"type": "string", "minLength": 1},
        "relation": {"enum": ["PRIMARY", "SECONDARY", "PREREQUISITE"]},
        "sourceVersion": {"type": "string", "minLength": 1}, "categoryFingerprint": {"type": "string", "minLength": 1},
        "scopeStatus": {"enum": ["CANDIDATE", "CONFIRMED"]}, "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "confidenceReason": {"type": "string", "minLength": 1}, "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "locatorStatus": {"enum": ["MISSING", "NOT_APPLICABLE", "ESTIMATED", "VERIFIED"]},
        "locatorReason": {"type": "string", "minLength": 1}, "locators": {"type": "array", "items": {"$ref": "#/$defs/locator"}},
        "review": {"$ref": "#/$defs/review"}
      },
      "allOf": [
        {"if": {"properties": {"locatorStatus": {"enum": ["MISSING", "NOT_APPLICABLE"]}}}, "then": {"properties": {"locators": {"maxItems": 0}}}},
        {"if": {"properties": {"locatorStatus": {"enum": ["ESTIMATED", "VERIFIED"]}}}, "then": {"properties": {"locators": {"minItems": 1}}}}
      ]
    }
  }
}
