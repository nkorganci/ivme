{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ivme.dev/schemas/ic-not-v1.schema.json",
  "title": "İvme iç kaynak notu v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "note_id", "source", "pages", "heading_path", "topic", "content", "review"],
  "properties": {
    "schema_version": {"const": 1},
    "note_id": {"type": "string", "pattern": "^ogm-note:[a-f0-9]{32}$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["catalog_id", "source_code", "pdf_sha256"],
      "properties": {
        "catalog_id": {"type": "integer", "minimum": 1},
        "source_code": {"type": "string", "pattern": "^ogm:[a-f0-9]{16}$"},
        "pdf_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "pages": {
      "type": "object", "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "integer", "minimum": 1},
        "end": {"type": "integer", "minimum": 1}
      }
    },
    "heading_path": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "topic": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "status"],
      "properties": {
        "code": {"type": ["string", "null"], "minLength": 1},
        "status": {"enum": ["unverified", "candidate", "verified"]}
      }
    },
    "content": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "method", "elements"],
      "properties": {
        "text": {"type": ["string", "null"]},
        "method": {"enum": ["pending", "pdf_text", "ocr", "manual"]},
        "elements": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "page", "reference"],
            "properties": {
              "kind": {"enum": ["formula", "figure", "table"]},
              "page": {"type": "integer", "minimum": 1},
              "reference": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "version"],
      "properties": {
        "status": {"enum": ["draft", "needs_review", "approved", "rejected"]},
        "version": {"type": "integer", "minimum": 1}
      }
    }
  }
}
