  "sections": {
    "s1": {
      "claims": [
        "asal",
        "usler",
        "aralarinda"
      ],
      "note": "Asal sayı tanımı kitabın sözlüğünden; asal çarpanlar EBOB–EKOK örneklerinde kullanılır. Pozitif bölen sayısı formülü kitapta yok: üs seçimlerini çarpma ilkesiyle sayan özgün türetimdir.",
      "exams": [
        "TYT",
        "AYT"
      ]
    },
    "s1b": {
      "claims": [
        "asal",
        "usler"
      ],
      "note": "Özgün türetim: koşullu bölen sayısı, bölenlerin toplamı ve asallık denemesi aynı üs seçim tablosundan çıkarılır; kitapta bu başlık yok.",
      "exams": [
        "TYT",
        "AYT"
      ]
    },
    "s2": {
      "claims": [
        "ebob_tanim",
        "ekok_tanim",
        "usler",
        "carpim"
      ],
      "note": "Tanımlar ve küçük/büyük üs kuralı kitaptan; çarpım ilişkisi iki sayma sayısı içindir.",
      "exams": [
        "TYT",
        "AYT"
      ]
    },
    "s2b": {
      "claims": [
        "ortak_kisim",
        "aralarinda_ebob",
        "kat",
        "carpim",
        "uc_sayi"
      ],
      "note": "a=dm, b=dn yazımı kitabın K=8x, L=8y örneğinin genellemesidir. Üç sayıda çarpım eşitliğinin bozulduğu örnek özgün türetimdir.",
      "exams": [
        "TYT",
        "AYT"
      ]
    },
    "s3": {
      "claims": [
        "ebob_tanim",
        "ebob_parca",
        "ebob_cevre"
      ],
      "note": "Bölme problemleri kitaptaki kare çim ve çevre direği örnekleriyle aynı ilkeye dayanır.",
      "exams": [
        "TYT",
        "AYT"
      ]
    },
    "s3b": {
      "claims": [
        "ebob_parca",
        "ebob_cevre"
      ],
      "note": "Özgün türetim: kalanlı EBOB (kalanları çıkarıp EBOB almak), açık yolda uç ağaç ve parça sınırı.",
      "exams": [
        "TYT",
        "AYT"
      ]
    },
    "s4": {
      "claims": [
        "ekok_tanim",
        "ekok_kalan",
        "ekok_ayni"
      ],
      "note": "Birleştirme ve aynı anda tekrar kitaptaki öğrenci ve makine örnekleriyle aynı ilkeye dayanır.",
      "exams": [
        "TYT",
        "AYT"
      ]
    },
    "s4b": {
      "claims": [
        "ekok_kalan",
        "ekok_tanim"
      ],
      "note": "Bölen−kalan farkının ortak olduğu durum, farklı kalanlarda tarama ve aralıkta sayma özgün türetimdir.",
      "exams": [
        "TYT",
        "AYT"
      ]
    },
    "s5": {
      "claims": [
        "gun",
        "baslangic",
        "ekok_periyot"
      ],
      "note": "Kurs ve nöbet örnekleri kitaptaki periyodik problemlerle aynıdır.",
      "exams": [
        "TYT",
        "AYT"
      ]
    },
    "s5b": {
      "claims": [
        "saat",
        "dongu",
        "gun"
      ],
      "note": "Kuvvetlerin son rakam döngüsü özgün türetimdir; kitap saat ve tekrar eden rakam dizisini verir.",
      "exams": [
        "TYT",
        "AYT"
      ]
    }
  },
