  <rect x="140" y="74" width="300" height="34" class="good soft"/>
  <rect x="140" y="74" width="100" height="34" class="good"/>
  <rect x="140" y="134" width="300" height="34" class="muted soft"/>
  <rect x="140" y="134" width="150" height="34" class="accent"/>
  <rect x="290" y="134" width="100" height="34" class="good"/>
  <g class="nofill" stroke-width="2" stroke="currentColor">
    <rect x="140" y="14" width="300" height="34"/><rect x="140" y="74" width="300" height="34"/><rect x="140" y="134" width="300" height="34"/>
